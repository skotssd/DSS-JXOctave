{
  "LiteBuildConfig": {
    "base_url": "/skotssd/DSS-JXOctave/",
    "output_dir": "dist",
    "extra_file_types": {
      "octave": {
        "name": "octave",
        "mimeTypes": ["text/x-octave"],
        "extensions": [".m"],
        "iconLabel": "octave"
      }
    }
  },
  "jupyter-config-data": {
    "enableMemoryStorage": true,
    "contentsStorageDrivers": ["MemoryStorage"],
    "workspacesStorageDrivers": ["MemoryStorage"],
    "settingsStorageDrivers": ["MemoryStorage"]
  }
}
