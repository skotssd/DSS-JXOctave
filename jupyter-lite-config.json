{
  "LiteBuildConfig": {
    "base_url": "/skotssd/DSS-JXOctave/",
    "output_dir": "dist",
    "extra_file_types": {
      "octave": {
        "name": "octave",
        "mimeTypes": ["text/x-octave"],
        "extensions": [".m"],
        "iconLabel": "octave"
      }
    }
  },
  "jupyter-config-data": {
    "settings_overrides": [
      {
        "id": "@jupyterlite/contents-extension:contents",
        "contentsStorageDrivers": ["memoryStorageDriver"],
        "settingsStorageDrivers": ["memoryStorageDriver"],
        "workspacesStorageDrivers": ["memoryStorageDriver"]
      }
    ]
  }
}
